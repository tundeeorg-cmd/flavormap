# Local PostgreSQL 15 + PostGIS via Docker Compose (see docker-compose.yml).
# POSTGRES_PASSWORD and the password embedded in DATABASE_URL must match.
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://flavormap:changeme@localhost:5432/flavormap

ANTHROPIC_API_KEY=sk-ant-...

# Included in the scraper's User-Agent string so site owners can reach us. Required by rule 7 (rate-limit rule).
SCRAPER_CONTACT_EMAIL=you@example.com
