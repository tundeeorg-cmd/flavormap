+# ── HD-43 option B: Q10-only dishes ───────────────────────────────────────────
+
+def _q10_only(**over: object) -> dict[str, object]:
+    dish: dict[str, object] = {"dish_no": 2, "name_th": "แกงอ่อม", "ingredients": [],
+                               "cooked_by_informant": False, "official_recipe_id": 7,
+                               "cook_status_verbatim": "ไม่มีใครทำแล้ว"}
+    dish.update(over)
+    base = _valid()
+    return _valid(dishes=[*base["dishes"], dish])  # type: ignore[list-item, misc]
+
+
+def test_a_q10_only_dish_parses_as_not_cooked() -> None:
+    iv = parse_interview("INT_BRM_001", _q10_only())
+    assert [d.cooked_by_informant for d in iv.dishes] == [True, False]
+
+
+@pytest.mark.parametrize(("over", "message"), [
+    ({"official_recipe_id": None}, "must name the state's dish"),
+    ({"ingredients": ["หอมแดง"]}, "no ingredients to record"),
+    ({"cooked_by_informant": "no"}, "must be true or false"),
+])
+def test_bad_q10_only_dishes_are_refused(over: dict[str, object], message: str) -> None:
+    _refused(_q10_only(**over), message)
+
+
+def test_a_q10_only_dish_writes_no_recipe(db_refs: dict[str, int], tmp_path: Path) -> None:
+    """T1.4's done-when: a Q10 answer about a dish the cook does not make produces zero
+    recipes rows."""
+    cooked = {"dish_no": 1, "name_th": "ยำลูกผึ้ง", "ingredients": ["ลูกผึ้ง"]}
+    q10_only = {"dish_no": 2, "name_th": "แกงอ่อม", "ingredients": [],
+                "cooked_by_informant": False, "official_recipe_id": db_refs["brm"],
+                "cook_status_verbatim": "ไม่มีใครทำแล้ว"}
+    load([parse_interview(IID, _valid(informant_id=IID, dishes=[cooked, q10_only]))],
+         tmp_path)
+    assert _q("SELECT count(*) FROM raw_recipes WHERE source_url LIKE %s",
+              f"interview:{IID}/%") == [(1,)]
+    assert _q("SELECT recipe_id IS NULL, cooked_by_informant FROM interview_dishes "
+              "WHERE dish_key = %s", f"{IID}/2") == [(True, False)]
