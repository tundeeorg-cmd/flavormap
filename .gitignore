.env
pgdata/

data/raw/
data/interim/
data/photos/

# Source PDFs anywhere under data/. The DCP corpus carries informant personal data
# (name, house number, road, postcode, mobile) and must never be committed. Scoped to
# data/ deliberately: the two specification PDFs at the repo root are tracked.
data/**/*.pdf

# Coverage tables are DCP-derived. HD-3 holds this source to reference-only, excluded
# from any public release, pending a reply to docs/dcp_permission_request.md. The
# directory is tracked so the path exists on clone (Bible §11); its contents are not.
data/coverage/*
!data/coverage/.gitkeep
# Exception (HD-28): status snapshots from `make status-snapshot` ARE committed. They
# carry aggregate counts only, never the DCP-derived per-province lists this rule exists
# to keep out, so progress is visible in git history rather than only in one database.
!data/coverage/status_*.md

# Database dumps (scripts/dump_db.sh writes data/exports/flavormap_*.sql.gz).
# The directory stays tracked via .gitkeep so the path exists on clone; its contents
# never do. A dump of this database carries the full parsed corpus — including anything
# a parser bug let through — into a public repository.
data/exports/*
!data/exports/.gitkeep

# Regenerated by `make analyze` (scripts/eligibility_sweep.py) from v_recipes_clean.
# Derived output, rebuilt on every run — the script is tracked, the result is not.
data/processed/eligibility_sweep.csv

figures/*
!figures/final/

# Dump artefacts written by hand outside data/exports/. Deliberately NOT `*.sql`:
# that would silently ignore all fourteen files in db/migrations/.
*.sql.gz
*.dump
*.pgdump

__pycache__/
*.py[cod]

.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

.DS_Store
